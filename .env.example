# =================================================================
# NEXORA ENTERPRISE PLATFORM ENVIRONMENT CONFIGURATION
# =================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Security & JWT Configuration
# 256-bit Hex Key for HMAC-SHA256 signing
APP_JWT_SECRET=replace-with-a-new-random-secret
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_COOKIE_NAME=nexora_token
APP_JWT_COOKIE_SECURE=false

# Database Configuration (Defaults to embedded zero-config H2)
# To use MySQL 8.0, activate spring profile: mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=nexora_db
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-local-database-password

# CORS Allowed Origins (Comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Automated Background Reports & File Uploads
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=50MB
